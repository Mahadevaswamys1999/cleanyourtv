<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFE2F3F2" />
            <stroke android:width="1dp" android:color="#FFFFFFFF" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then). -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#3859BDB6" />
            <stroke android:width="1.5dp" android:color="#FF8AE2DF" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#A617202B" />
            <stroke android:width="1dp" android:color="#50A3B6C3" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
